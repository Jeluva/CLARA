# CLARA backend — copy to .env and fill in. .env is gitignored.

# App
ENVIRONMENT=development

# Database. SQLite (default) for dev; swap to Postgres in prod, e.g.:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/clara
# DATABASE_URL=sqlite:///./clara.db

# CORS (JSON list). Defaults already include localhost:5180 (dev), 4180
# (vite preview) and the prod Vercel URL — only set this to override them
# (e.g. a different Vercel deployment URL or a preview-branch URL).
# CORS_ORIGINS=["https://clara-jet.vercel.app"]

# External sources. Leave blank to use the documented realistic mocks.
NEWS_API_KEY=
YOUTUBE_API_KEY=

# Webshare residential proxy for yt-dlp/youtube-transcript-api. Required in
# prod: YouTube blocks cloud-provider IPs (Render, AWS, etc.) outright, so
# without this, real transcript ingestion silently finds nothing. Get
# credentials at webshare.io — use the "Residential" plan, NOT "Proxy
# Server" (that one is datacenter IPs and gets blocked the same way).
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=

# Shared secret for POST /api/transcripts/ingest-external. Free alternative
# to the proxy above: run scripts/fetch_transcripts_local.py from your own
# PC (residential IP, not blocked by YouTube) and it pushes results here.
# Leave blank to keep the endpoint disabled. Pick any random string.
INGEST_SECRET=

# LLM chatbot — provider priority (first key set wins, falls through on quota):
#   1. Groq (Llama 3.3 70B) — free tier, console.groq.com
#   2. Qwen (DashScope)     — free tier, dashscope.aliyuncs.com
#   3. Gemini               — free tier, aistudio.google.com
#   4. Anthropic (Claude)   — paid, console.anthropic.com
#   5. Ollama (local, OLLAMA_ENABLED=true) — free, no key, but see caveat below.
#   6. Static (no key needed) — rule-based analysis, always works.
GROQ_API_KEY=
QWEN_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# CHAT_MODEL=  # override default model for any provider

# Local model via Ollama (docs/devlog/BACKLOG.md v5 item 3). Off by default
# on purpose, not just because prod has no Ollama running: measured live
# against a 9B Q4 quant on a CPU-only box, ~0.53s/token (a short reply
# takes minutes) and the model ignored the given context in 2/2 real runs
# (asked about a stock, answered about currency rates once and geopolitics
# once). Turn on only if you've verified your own model/hardware does
# better than that — otherwise it's a strictly worse answer than Static.
OLLAMA_ENABLED=false
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen-aggressive

# When true, ingestion never hits the network and uses fixtures/mocks.
USE_MOCK_SOURCES=true

# Background ingestion scheduler (APScheduler). Off by default.
SCHEDULER_ENABLED=false
