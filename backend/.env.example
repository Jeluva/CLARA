# CLARA backend — copy to .env and fill in. .env is gitignored.

# App
ENVIRONMENT=development

# Database. SQLite (default) for dev; swap to Postgres in prod, e.g.:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/clara
# DATABASE_URL=sqlite:///./clara.db

# CORS (JSON list)
# CORS_ORIGINS=["http://localhost:5173"]

# External sources. Leave blank to use the documented realistic mocks.
NEWS_API_KEY=
YOUTUBE_API_KEY=

# LLM chatbot — provider priority (first key set wins, falls through on quota):
#   1. Groq (Llama 3.3 70B) — free tier, console.groq.com
#   2. Qwen (DashScope)     — free tier, dashscope.aliyuncs.com
#   3. Gemini               — free tier, aistudio.google.com
#   4. Anthropic (Claude)   — paid, console.anthropic.com
#   5. Static (no key needed) — rule-based analysis, always works.
GROQ_API_KEY=
QWEN_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# CHAT_MODEL=  # override default model for any provider

# When true, ingestion never hits the network and uses fixtures/mocks.
USE_MOCK_SOURCES=true

# Background ingestion scheduler (APScheduler). Off by default.
SCHEDULER_ENABLED=false
