# CLARA frontend — copy to .env.production (or set in the Vercel dashboard).

# Backend origin when frontend and backend are deployed separately (e.g.
# frontend on Vercel, backend on Render). Leave unset for same-origin /api
# (local dev — Vite proxies it to FastAPI, see vite.config.ts).
# VITE_API_URL=https://clara-backend.onrender.com
